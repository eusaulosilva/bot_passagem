# URLs monitoradas (trecho Brasília - DF -> Santa Rita de Cássia - BA em 18/12/2026)
URL_GUANABARA=https://viajeguanabara.com.br/onibus/brasilia-df/santa_rita_de_cassia-ba/?departure_date=2026-12-18&passengers=13:1
URL_CLICKBUS=https://www.clickbus.com.br/onibus/brasilia-df-todos/santa-rita-cassia-ba?departureDate=2026-12-18&gratuity=true

# Credenciais do Bot do Telegram
TELEGRAM_TOKEN=seu_token_do_botfather_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# false = executa uma única vez (ideal para GitHub Actions)
# true = executa continuamente em loop local
MODO_LOOP_LOCAL=false

# Intervalo em segundos no modo loop local (ex.: 300 = 5 min, 600 = 10 min)
INTERVALO_SEGUNDOS=300

# false = envia alerta apenas quando a passagem abre ou o preço muda (evita spam)
# true = envia alerta em toda execução enquanto houver passagem disponível
NOTIFICAR_SEMPRE=false
